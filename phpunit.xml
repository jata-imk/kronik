<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_CONNECTION" value="sqlite"/>
        <env name="DB_DATABASE" value=":memory:"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SIC_QA_HABILITADO" value="false"/>
        <env name="SIC_CA_BUNDLE" value=""/>
        <env name="CIRCULO_CREDITO_API_KEY" value="TEST-NO-PROVIDER-CREDENTIAL"/>
        <env name="CIRCULO_CREDITO_SANDBOX" value="true"/>
        <env name="ORIGINACION_APROBACIONES_HABILITADAS" value="false"/>
        <env name="ORIGINACION_PAQUETES_QA_HABILITADOS" value="false"/>
        <env name="ORIGINACION_FIRMAS_QA_HABILITADAS" value="false"/>
        <env name="ORIGINACION_DESEMBOLSOS_QA_HABILITADOS" value="false"/>
        <env name="ORIGINACION_PAGOS_QA_HABILITADOS" value="false"/>
        <env name="ORIGINACION_ANTICIPOS_QA_HABILITADOS" value="false"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
    </php>
</phpunit>
